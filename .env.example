# Local development only. Real builds take these from eas.json (per build profile).
# Nothing is sent to PostHog/Sentry from development builds, so these are rarely needed.

# API server override (see src/lib/api.ts). Defaults to production when unset.
# EXPO_PUBLIC_API_BASE_URL=https://oneview.qodeinvest.com

# Analytics (public client identifiers; see docs/analytics.md)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://posthog.qodeinvest.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development

# Secret: source-map upload during builds. EAS secret / CI only — never commit a value.
# SENTRY_AUTH_TOKEN=
